# Menonaktifkan MultiViews dan directory listing
Options -Indexes

# Mengaktifkan modul Rewrite
RewriteEngine On

# =================================================================
# ROUTING LANDING PAGES → views/landing/
# URL publik tetap sama (/index, /layanan-umkm, dst.)
# =================================================================

# Blokir akses URL langsung ke views/ — hanya dari browser, bukan hasil rewrite internal
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteRule ^views/ - [F,L]

# Halaman beranda: / atau /index
RewriteRule ^$ views/landing/index.php [L]
RewriteRule ^index(\.php)?$ views/landing/index.php [L]

# Redirect apbpekon-2026 → apbpekon (1 file, data tahun terbaru otomatis) — relative agar benar di subdirektori
RewriteRule ^apbpekon-2026(\.php)?/?$ apbpekon [R=301,L]

# Landing pages lainnya → views/landing/
RewriteRule ^(layanan-umkm|kontak|pemerintahan|potensi-ekonomi|profil-desa|apbpekon)(\.php)?/?$ views/landing/$1.php [L]

# =================================================================
# ROUTING DASHBOARD → views/dashboard/
# URL tetap /dashboard/admin
# =================================================================
RewriteRule ^dashboard/admin(\.php)?$ views/dashboard/admin.php [L]

# =================================================================
# FALLBACK: file PHP lain tanpa ekstensi (auth, api, dll.)
# =================================================================
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [L]

# Blokir akses langsung ke file yang diawali dengan tanda titik (.)
<FilesMatch "^\.">
   Order Deny,Allow
   Deny from all
</FilesMatch>

# Batasi metode HTTP yang diizinkan
<LimitExcept GET POST>
   Deny from all
</LimitExcept>

# Aktifkan kompresi GZIP
<IfModule mod_deflate.c>
   AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript
</IfModule>

# Pengaturan cache untuk file statis
<IfModule mod_expires.c>
   ExpiresActive On
   ExpiresByType image/jpg "access plus 1 month"
   ExpiresByType image/jpeg "access plus 1 month"
   ExpiresByType image/gif "access plus 1 month"
   ExpiresByType image/png "access plus 1 month"
   ExpiresByType text/css "access plus 1 month"
   ExpiresByType application/pdf "access plus 1 month"
   ExpiresByType application/javascript "access plus 1 month"
   ExpiresByType text/javascript "access plus 1 month"
   ExpiresByType application/x-shockwave-flash "access plus 1 month"
   ExpiresByType image/x-icon "access plus 1 year"
   ExpiresDefault "access plus 2 days"
</IfModule>

# ============================================================
# KEAMANAN APLIKASI (OWASP Top 10)
# ============================================================

# A05 - Header keamanan (CSP, nosniff, frame, referrer, permissions)
<IfModule mod_headers.c>
   Header set X-Content-Type-Options "nosniff"
   Header set X-Frame-Options "SAMEORIGIN"
   Header set Referrer-Policy "strict-origin-when-cross-origin"
   Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
   Header set X-XSS-Protection "0"
   Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' data: blob:; connect-src 'self'; frame-src 'self' https://www.google.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
</IfModule>

# A05 - HSTS bila diakses via HTTPS
<IfModule mod_headers.c>
   Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

# A01/A05 - Blokir akses langsung ke folder sensitif
# (pengecualian: endpoint publik login, form aspirasi, dan ajax di functions/)
RewriteRule ^functions/(function_auth|function_aspirasi)\.php$ - [L]
RewriteRule ^functions/ajax/layanan-umkm-data\.php$ - [L]
RewriteRule ^(includes|functions|db|Zzz|@agents|docs|graphify-out|\.grok|\.rtk)(/|$) - [F,L]

# A01/A05 - Blokir file data/konfigurasi/sumber sensitif
<FilesMatch "\.(json|log|bak|sql|env|ini|md|lock|pem|key|db)$">
   Require all denied
</FilesMatch>
<FilesMatch "^(data\.php|config\.php|security\.php)$">
   Require all denied
</FilesMatch>
